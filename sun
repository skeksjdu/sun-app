<p class="note" id="arerr" hidden></p>
<section class="card">
<div class="big" id="tl"></div>
<input id="ts" type="range" min="0" max="24" step="0.01">
<div class="row"><button id="br">일출로</button><button id="bs">일몰로</button><button id="bp">▶ 재생</button><button id="now">지금</button><button id="bar">📷 AR</button></div>
</section>
