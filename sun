</section>
<canvas id="sky" width="640" height="480"></canvas>
<section class="card" id="arbox" hidden><div class="arw"><video id="vid" playsinline muted autoplay></video><canvas id="ar"></canvas></div>
<label>방위 보정 <span id="calv">0°</span><input id="acal" type="range" min="-45" max="45" value="0"></label>
